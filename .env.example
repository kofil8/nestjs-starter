# ─── App ───────────────────────────────────────────
APP_NAME=MyApp
DESCRIPTION=A NestJS production application
PORT=9001
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp?schema=public

# ─── JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
REFRESH_SECRET=change-me-to-another-long-random-string-min-16-chars

# ─── Redis ──────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── CORS ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Throttle (Rate Limiting) ──────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ─── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@yourapp.com

# ─── File Uploads ──────────────────────────────────
FILE_STORAGE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── S3 (if FILE_STORAGE=s3) ────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=myapp-uploads

# ─── BetterStack (Logging) ─────────────────────────
BETTERSTACK_SOURCE_TOKEN=
