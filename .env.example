# ─── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=9001
APP_URL=http://localhost:9001

# ─── Database (PostgreSQL) ──────────────────────────
# In Docker, use the service name as host: nest-blog-postgres
DATABASE_URL=postgresql://postgres:postgres@nest-blog-postgres:5432/nest-blog?schema=public

# ─── JWT (both must be at least 32 characters) ──────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long

# ─── Redis ───────────────────────────────────────────
# In Docker, use the service name as host: nest-blog-redis
REDIS_HOST=nest-blog-redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Throttle ────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ─── Email (Resend - optional) ──────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=noreply@yourapp.com

# ─── File Uploads ────────────────────────────────────
FILE_STORAGE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── S3 (only needed if FILE_STORAGE=s3) ────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
